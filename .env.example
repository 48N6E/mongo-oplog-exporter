# Copy to .env and edit: cp .env.example .env
# Create the exporter MongoDB user first — see README.md

MONGO_URL=mongodb://exporter:change-me@host.docker.internal:27017/?authSource=admin
MONGO_DIRECT_CONNECTION=true

PORT=7777

OPEN_OPLOG=true
OPENLOG_OPLOG=false
OPLOG_METRICS_TYPE=counter
OPLOG_METRICS_NAME=log_to_metric_mongo_oplog
OPLOG_IGNORE_OP=["n"]
OPLOG_IGNORE_FIELD=["lsid","ui","prevOpTime","stmtId","ts","txnNumber","wall","o2","o","postImageOpTime","h","fromMigrate"]
OPLOG_INIT_LABEL=["op","ns","node_name","service_name","t","cluster","v","o2","lsid","ui","prevOpTime","stmtId","ts","txnNumber","wall","preImageOpTime","writeConflicts","transaction","fromMigrate"]

OPEN_CURRENTOP=true
OPENLOG_CURRENTOP=false
CURRENTOP_INTERVAL=20000
CURRENTOP_METRICS_TYPE=counter
CURRENTOP_METRICS_NAME=log_to_metric_mongo_currentop
CURRENTOP_IGNORE_OP=["none"]
CURRENTOP_IGNORE_FIELD=["lsid","waitingForFlowControl","flowControlStats","numYields","currentOpTime","clientMetadata","command.$clusterTime","locks","waitingForLock","lockStats","threadId"]
# Default: empty — system ops (admin.$cmd, hello, …) are exported.
# Tip: in production, filter noise to reduce cardinality, e.g.:
# CURRENTOP_IGNORE_KEYVALUE=[{"command":"hello"},{"command":"currentOp"},{"command":"isMaster"},{"appName":"OplogFetcher"},{"ns":"admin"},{"ns":"local"},{"appName":"QAN"}]
CURRENTOP_IGNORE_KEYVALUE=[]
CURRENTOP_INIT_LABEL=["command","opid","v","active","t","connectionId","desc","host","type","exporter_type","effectiveUsers","client","clientMetadata","secs_running","microsecs_running","waitingForLatch","appName","planSummary","cursor","preImageOpTime","writeConflicts","transaction","postImageOpTime","originatingCommand","query","fromMigrate"]
